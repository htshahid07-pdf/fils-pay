# Settings for docker-compose.proxy.yml. Not secret.
# Both names must have DNS A records pointing at this server's public IP.
# No domain? Use sslip.io with your server IP, e.g. 203.0.113.10.sslip.io
# and admin.203.0.113.10.sslip.io (they resolve to that IP automatically).
FILSPAY_DOMAIN=filspay.example.com
ADMIN_DOMAIN=admin.filspay.example.com
# Let's Encrypt contact address for the HTTPS certificates.
ACME_EMAIL=you@example.com
